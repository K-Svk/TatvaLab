
# ==============================
# TatvaLab - Git Ignore
# ==============================

# Node.js dependencies
node_modules/
Frontend/node_modules/

# React / Vite build files
dist/
dist-ssr/
Frontend/dist/

# Environment variables and secrets
.env
.env.*
!.env.example
backend/.env
Frontend/.env
Frontend/.env.local
backend/.env.local

# Python virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Local databases
*.sqlite3
*.db

# Temporary files
*.tmp
*.temp
*.bak

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
Thumbs.db
Desktop.ini
